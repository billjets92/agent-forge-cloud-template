{
  "name": "my-forge-cloud-agent",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "ai": { "binding": "AI" },
  "d1_databases": [{"binding":"DB","database_name":"forge-cloud-state","database_id":"00000000-0000-0000-0000-000000000000"}],
  "vars": { "FREE_PLAN_ONLY": "not-confirmed" },
  "observability": { "enabled": false }
}
